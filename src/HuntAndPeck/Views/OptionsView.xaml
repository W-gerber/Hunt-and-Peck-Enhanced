<Window x:Class="HuntAndPeck.Views.OptionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:HuntAndPeck.Models"
        xmlns:views="clr-namespace:HuntAndPeck.Views"
        Title="Hunt and Peck Enhanced"
        Icon="/Resources/originalbird.ico"
        Width="780" Height="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Catppuccin Mocha, matching the GlazeWM / tacky-borders desktop. -->
        <SolidColorBrush x:Key="Base"     Color="#1E1E2E" />
        <SolidColorBrush x:Key="Mantle"   Color="#181825" />
        <SolidColorBrush x:Key="Crust"    Color="#11111B" />
        <SolidColorBrush x:Key="Surface0" Color="#313244" />
        <SolidColorBrush x:Key="Surface1" Color="#45475A" />
        <SolidColorBrush x:Key="Surface2" Color="#585B70" />
        <SolidColorBrush x:Key="Text"     Color="#CDD6F4" />
        <SolidColorBrush x:Key="Subtext"  Color="#A6ADC8" />
        <SolidColorBrush x:Key="Muted"    Color="#7F849C" />
        <SolidColorBrush x:Key="Accent"   Color="#89B4FA" />
        <SolidColorBrush x:Key="Danger"   Color="#F38BA8" />

        <views:HintBrushConverter x:Key="HintBrush" />

        <!-- ==================== Data ==================== -->
        <x:Array x:Key="FontSizeList" Type="sys:String">
            <sys:String>9</sys:String><sys:String>10</sys:String><sys:String>11</sys:String>
            <sys:String>12</sys:String><sys:String>13</sys:String><sys:String>14</sys:String>
            <sys:String>15</sys:String><sys:String>16</sys:String><sys:String>18</sys:String>
            <sys:String>20</sys:String><sys:String>22</sys:String><sys:String>24</sys:String>
        </x:Array>

        <!-- Values must stay byte-identical so previously saved settings resolve. -->
        <x:Array x:Key="ActiveColors" Type="models:ColorOption">
            <models:ColorOption Name="Gold"        Value="#F9CD33" Note="default" />
            <models:ColorOption Name="Yellow"      Value="Yellow" />
            <models:ColorOption Name="Orange"      Value="Orange" />
            <models:ColorOption Name="Light green" Value="#90EE90" />
            <models:ColorOption Name="Sky blue"    Value="#87CEEB" />
            <models:ColorOption Name="Light pink"  Value="#FFB6C1" />
            <models:ColorOption Name="Plum"        Value="#DDA0DD" />
            <models:ColorOption Name="Tomato"      Value="#FF6347" />
            <models:ColorOption Name="Lime"        Value="Lime" />
        </x:Array>

        <x:Array x:Key="InactiveColors" Type="models:ColorOption">
            <models:ColorOption Name="Dark gold"    Value="#E6C030" Note="default" />
            <models:ColorOption Name="Light yellow" Value="#FFFFE0" />
            <models:ColorOption Name="Moccasin"     Value="#FFE4B5" />
            <models:ColorOption Name="Pale green"   Value="#98FB98" />
            <models:ColorOption Name="Light blue"   Value="#ADD8E6" />
            <models:ColorOption Name="Pink"         Value="#FFC0CB" />
            <models:ColorOption Name="Lavender"     Value="#E6E6FA" />
            <models:ColorOption Name="Light grey"   Value="#D3D3D3" />
        </x:Array>

        <x:Array x:Key="TextColors" Type="models:ColorOption">
            <models:ColorOption Name="Black"     Value="Black" Note="default" />
            <models:ColorOption Name="White"     Value="White" />
            <models:ColorOption Name="Dark grey" Value="#333333" />
            <models:ColorOption Name="Navy"      Value="Navy" />
            <models:ColorOption Name="Purple"    Value="Purple" />
            <models:ColorOption Name="Brown"     Value="Brown" />
        </x:Array>

        <DataTemplate x:Key="ColorItemTemplate" DataType="{x:Type models:ColorOption}">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="4"
                        Background="{Binding Value}"
                        BorderBrush="#55FFFFFF" BorderThickness="1"
                        Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note}" FontSize="11" Margin="8,0,0,0"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One hint label, drawn with the same brushes as the real overlay. -->
        <DataTemplate x:Key="PreviewHint">
            <Border Background="{Binding Color, Converter={StaticResource HintBrush}}"
                    BorderBrush="{Binding Color, Converter={StaticResource HintBrush}, ConverterParameter=border}"
                    CornerRadius="3" Padding="4,1" BorderThickness="1" Margin="9,0">
                <TextBlock Text="{Binding Label}" FontWeight="Bold"
                           FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border>
        </DataTemplate>

        <!-- ==================== Typography ==================== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,4,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="SettingHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Subtext}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#232334" />
            <Setter Property="BorderBrush" Value="{StaticResource Surface0}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="Margin" Value="-20,16" />
        </Style>

        <!-- ==================== Shortcut box ====================
             Click it, then press the new combo. Shows the current shortcut
             as key caps; shows a prompt while it is listening. -->
        <DataTemplate x:Key="KeyCap">
            <Border Background="{StaticResource Surface1}"
                    BorderBrush="{StaticResource Surface2}" BorderThickness="0,0,0,2"
                    CornerRadius="4" Padding="9,3" Margin="3,0">
                <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="HotKeyBox" TargetType="Button">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Click, then press the new shortcut. Esc cancels." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource Surface0}"
                                BorderBrush="{StaticResource Surface1}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <ContentPresenter x:Name="Value"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="Prompt" Text="Press a shortcut…"
                                           FontSize="12.5" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D45" />
                                <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Prompt" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Scroll bar ==================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="#3A3A4E" CornerRadius="4" Margin="3,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#55586E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ComboBox ==================== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Margin="4,1" Padding="10,7" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,34,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Data="M 0,0 L 5,5 L 10,0"
                                  Stroke="{StaticResource Subtext}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Mantle}"
                                        BorderBrush="{StaticResource Surface1}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" Margin="0,4" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Sidebar navigation ==================== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Subtext}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Margin="12,2" Padding="12,9" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="Ind" Width="3" RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left" Margin="-8,3,0,3"
                                           Fill="{StaticResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24243A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0}" />
                                <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Mantle}"
                                    BorderBrush="{StaticResource Surface0}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,24">
                                        <Image Source="/Resources/originalbird.ico" Width="34" Height="34"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hunt and Peck" FontSize="14.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" />
                                            <TextBlock Text="Enhanced" FontSize="12" Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="24,0,16,20"
                                               FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="Based on Hunt and Peck by Zachary Sims" />
                                    <StackPanel IsItemsHost="True" VerticalAlignment="Top" />
                                </DockPanel>
                            </Border>

                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs">

        <!-- ================================================== SHORTCUTS -->
        <TabItem Header="Shortcuts">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,10">
                <StackPanel>
                    <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Click a shortcut, then press the keys you want. Esc cancels." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Show hints" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Labels everything you can click in the active window."
                                               Style="{StaticResource SettingHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="Main" Style="{StaticResource HotKeyBox}"
                                        PreviewKeyDown="HotKeyBox_OnPreviewKeyDown"
                                        GotKeyboardFocus="HotKeyBox_OnGotKeyboardFocus"
                                        LostKeyboardFocus="HotKeyBox_OnLostKeyboardFocus">
                                    <ItemsControl ItemsSource="{Binding MainHotKeyParts}"
                                                  ItemTemplate="{StaticResource KeyCap}"
                                                  ItemsPanel="{StaticResource Row}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding MainHotKeyError}" Style="{StaticResource ErrorText}" />

                            <Border Style="{StaticResource Divider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Show taskbar hints" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="Labels the taskbar and the notification area."
                                               Style="{StaticResource SettingHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="Taskbar" Style="{StaticResource HotKeyBox}"
                                        PreviewKeyDown="HotKeyBox_OnPreviewKeyDown"
                                        GotKeyboardFocus="HotKeyBox_OnGotKeyboardFocus"
                                        LostKeyboardFocus="HotKeyBox_OnLostKeyboardFocus">
                                    <ItemsControl ItemsSource="{Binding TaskbarHotKeyParts}"
                                                  ItemTemplate="{StaticResource KeyCap}"
                                                  ItemsPanel="{StaticResource Row}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding TaskbarHotKeyError}" Style="{StaticResource ErrorText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================================================= APPEARANCE -->
        <TabItem Header="Appearance">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,10">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="How hint labels look over your windows. Changes show on the next hint." />

                    <!-- Preview: the same brushes and template the overlay uses. -->
                    <Border Background="{StaticResource Crust}" BorderBrush="{StaticResource Surface0}"
                            BorderThickness="1" CornerRadius="8" Height="96" Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding PreviewHints}"
                                      ItemTemplate="{StaticResource PreviewHint}"
                                      ItemsPanel="{StaticResource Row}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="TEXT" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{StaticResource FontSizeList}" SelectedValue="{Binding FontSize}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Font" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding FontFamilies}" SelectedValue="{Binding FontFamily}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{StaticResource TextColors}"
                                          ItemTemplate="{StaticResource ColorItemTemplate}"
                                          SelectedValuePath="Value" SelectedValue="{Binding TextColor}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="BACKGROUND" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hint" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{StaticResource InactiveColors}"
                                          ItemTemplate="{StaticResource ColorItemTemplate}"
                                          SelectedValuePath="Value" SelectedValue="{Binding InactiveBackgroundColor}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Matches what you typed" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{StaticResource ActiveColors}"
                                          ItemTemplate="{StaticResource ColorItemTemplate}"
                                          SelectedValuePath="Value" SelectedValue="{Binding BackgroundColor}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
